git_current_branch() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null
}

## Commit with a message (default: update)
gcmsg() {
  git commit -m "${*:-update}"
}

## Add all, commit with a message (default: update), and push
gu() {
  local msg="${*:-update}"

  git add --all &&
  git commit -m "$msg" &&
  git push
}

# Fast-forward master to the current branch without checking it out.
_git_ff_master() {
  local branch
  branch=$(git_current_branch)

  if [[ -z "$branch" || "$branch" == master ]]; then
    echo "Error: check out a branch other than master first" >&2
    return 1
  fi

  if ! git fetch --quiet . "$branch:master"; then
    echo "Error: cannot fast-forward master to $branch" >&2
    return 1
  fi

  echo "Fast-forwarded master to $branch"
}

## Fast-forward master to this branch, switch to master, delete the branch
gffm() {
  local branch
  branch=$(git_current_branch)

  _git_ff_master &&
  git checkout master &&
  git branch -d "$branch"
}

## Fast-forward master to this branch and stay on the branch
gffmb() {
  _git_ff_master
}

