## Kill the processes listening on a port: killport <port>
killport() {
  if [ -z "$1" ]; then
    echo "Error: Port number required"
    echo "Usage: killport <port>"
    return 1
  fi

  local port="$1"
  local pids=$(lsof -ti tcp:"$port" | tr '\n' ' ')

  if [ -z "$pids" ]; then
    echo "No process found on port $port"
    return 1
  fi

  kill -9 $pids
  echo "Killed process(es) on port $port: $pids"
}

## List these shortcuts, optionally for one section: shortcuts [section]
shortcuts() {
  awk -v filter="${1,,}" '
    function show(name, text) {
      if (filter != "" && tolower(section) != filter) return
      if (section != printed) {
        printf "%s%s\n", (printed == "" ? "" : "\n"), section
        printed = section
      }
      printf "  %-20s %s\n", name, text
    }
    /^#@ / { section = substr($0, 4); desc = ""; next }
    /^## / { desc = substr($0, 4); next }
    /^alias / {
      name = $0; sub(/^alias /, "", name); sub(/=.*/, "", name)
      cmd = $0; sub(/^[^=]*=/, "", cmd); gsub(/^\047|\047$/, "", cmd)
      show(name, desc != "" ? desc : cmd)
    }
    /^[A-Za-z_][A-Za-z0-9_]*\(\)/ && desc != "" {
      name = $0; sub(/\(\).*/, "", name)
      show(name, desc)
    }
    { desc = "" }
  ' "${BASH_SOURCE[0]}"
}

#@ Jslib
## Unlink all mrzli-jslib packages
mrzli_jslib_unlink() {
  local repos_dir="$HOME/projects/personal/mrzli-jslib"
  local repo_dir

  for repo_dir in "$repos_dir"/*/; do
    [[ -d "$repo_dir" ]] || continue
    bun unlink --cwd "$repo_dir" >/dev/null 2>&1 || true
  done
}

## Link all mrzli-jslib packages
mrzli_jslib_link() {
  local repos_dir="$HOME/projects/personal/mrzli-jslib"
  local repo_dir

  for repo_dir in "$repos_dir"/*/; do
    [[ -d "$repo_dir" ]] || continue
    echo "Linking ${repo_dir%/}"
    bun link --cwd "$repo_dir" || return
  done
}

## Unlink and relink all mrzli-jslib packages
mrzli_jslib_relink() {
  mrzli_jslib_unlink
  mrzli_jslib_link
}

## Build all mrzli-jslib packages in parallel
mrzli_jslib_build() {
  local repos_dir="$HOME/projects/personal/mrzli-jslib"
  local repo_dir
  local status=0
  local -a pids=()

  if [[ ! -d "$repos_dir" ]]; then
    echo "Repository directory does not exist: $repos_dir" >&2
    return 1
  fi

  for repo_dir in "$repos_dir"/*/; do
    [[ -d "$repo_dir" ]] || continue

    (
      echo "Building ${repo_dir%/}"
      cd "$repo_dir" || exit 1
      bun run build
    ) &

    pids+=("$!")
  done

  for pid in "${pids[@]}"; do
    wait "$pid" || status=1
  done

  if (( status == 0 )); then
    echo "All libraries built successfully."
  else
    echo "One or more library builds failed." >&2
  fi

  return "$status"
}

