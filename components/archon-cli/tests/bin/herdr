#!/usr/bin/env ruby
require 'json'

# All operations are simulated. A fixture path is mandatory, including for launch.
File.open(ENV.fetch('HERDR_TEST_STATE'), 'r+') do |file|
  file.flock(File::LOCK_EX)
  state = JSON.parse(file.read)
  arguments = ARGV.dup
  flag, session = arguments.shift(2)
  raise 'test Herdr requires an explicit session' unless flag == '--session'
  state['other_sessions'] ||= [{ 'name' => 'default', 'running' => true }]
  state['targets'] ||= []
  state['targets'] << [session, arguments]
  unless session == 'archon' || %w[list stop delete].include?(arguments[1]) && arguments.first == 'session'
    raise 'workspace operations require the archon session'
  end
  state['calls'] << arguments
  failure = state['failure']
  failed = failure && failure['remaining'] > 0 && (failure['prefix'].empty? ? arguments.empty? : arguments.first(failure['prefix'].length) == failure['prefix'])
  response = nil
  if failed
    failure['remaining'] -= 1
    warn JSON.generate(error: { code: 'injected_failure', message: 'injected Herdr failure' })
  else
    new_tab = lambda do |workspace, label|
      state['next_id'] += 1
      id = state['next_id'] * 7
      tab = { 'tab_id' => "#{workspace['workspace_id']}:t#{id}", 'label' => label,
              'pane_id' => "#{workspace['workspace_id']}:p#{id}", 'commands' => [] }
      workspace['tabs'] << tab
      tab
    end
    option = ->(name) { arguments[arguments.index(name) + 1] }
    workspaces = state['workspaces']
    case arguments.first(2)
    when ['session', 'list']
      sessions = state['other_sessions'].map do |item|
        item.merge('default' => item['name'] == 'default', 'session_dir' => File.join(ENV.fetch('XDG_CONFIG_HOME'), 'herdr'))
      end
      sessions.unshift({ name: 'archon', default: false, running: state['running'] }) unless state['archon_deleted']
      response = { sessions: sessions }
    when ['session', 'stop']
      raise 'wrong session stop target' unless arguments == ['session', 'stop', session, '--json']
      if session == 'archon'
        state['running'] = false
      else
        state['other_sessions'].find { |item| item.fetch('name') == session }.store('running', false)
      end
      response = { session: { name: session, running: false } }
    when ['session', 'delete']
      raise 'default session cannot be deleted' if session == 'default'
      if session == 'archon'
        raise 'session is running' if state['running']
        state['archon_deleted'] = true
        workspaces.clear
        state['next_id'] = 0
      else
        target = state['other_sessions'].find { |item| item.fetch('name') == session }
        raise 'session is running' if target && target['running']
        state['other_sessions'].delete(target)
      end
      response = { deleted: true }
    when ['workspace', 'list']
      raise 'session not running' unless state['running']
      response = { result: { workspaces: workspaces.map { |workspace| workspace.reject { |key, _| %w[cwd tabs].include?(key) } } } }
    when ['workspace', 'create']
      raise 'session not running' unless state['running']
      state['next_id'] += 1
      workspace = { 'workspace_id' => "w#{state['next_id'] * 7}", 'label' => option.call('--label'),
                    'cwd' => option.call('--cwd'), 'tabs' => [] }
      workspaces << workspace
      tab = new_tab.call(workspace, 'initial shell')
      response = { result: { workspace: workspace, tab: tab, root_pane: { pane_id: tab['pane_id'] } } }
    when ['workspace', 'close']
      workspace = workspaces.find { |item| item['workspace_id'] == arguments[2] }
      raise 'unknown workspace' unless workspace
      workspaces.delete(workspace)
      if workspaces.empty? && state['client_attached']
        state['next_id'] += 1
        workspaces << { 'workspace_id' => "w#{state['next_id'] * 7}", 'label' => '~', 'tabs' => [] }
      end
      response = { result: { workspace_id: workspace['workspace_id'] } }
    when ['workspace', 'focus']
      raise 'unknown workspace' unless workspaces.any? { |item| item['workspace_id'] == arguments[2] }
      state['focused'] = arguments[2]
      response = { result: {} }
    when ['workspace', 'rename']
      workspace = workspaces.find { |item| item['workspace_id'] == arguments[2] }
      raise 'unknown workspace' unless workspace
      workspace['label'] = arguments[3]
      response = { result: { workspace: workspace } }
    when ['tab', 'create']
      workspace = workspaces.find { |item| item['workspace_id'] == option.call('--workspace') }
      tab = new_tab.call(workspace, option.call('--label'))
      response = { result: { tab: tab, root_pane: { pane_id: tab['pane_id'] } } }
    when ['tab', 'rename']
      tab = workspaces.flat_map { |item| item['tabs'] }.find { |item| item['tab_id'] == arguments[2] }
      tab['label'] = arguments[3]
      response = { result: { tab: tab } }
    when ['pane', 'run']
      tab = workspaces.flat_map { |item| item['tabs'] }.find { |item| item['pane_id'] == arguments[2] }
      tab['commands'] << arguments[3]
    when ['server']
      state['running'] = true
      state['archon_deleted'] = false
    when []
      state['attachments'] += 1
    else
      raise "unexpected test Herdr arguments: #{arguments.inspect}"
    end
  end
  file.rewind
  file.write(JSON.generate(state))
  file.truncate(file.pos)
  puts JSON.generate(response) if response
  exit(failed ? 1 : 0)
end
