#!/usr/bin/env bash

set -u

state_dir="${TMW_TMUX_STATE:?TMW_TMUX_STATE must be set}"
sessions_dir="$state_dir/sessions"
mkdir -p "$sessions_dir"

printf '%q' "$0" >> "$state_dir/calls"
printf ' %q' "$@" >> "$state_dir/calls"
printf '\n' >> "$state_dir/calls"

command="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

if [ "${TMW_TMUX_FAIL_COMMAND:-}" = "$command" ]; then
  echo "forced tmux failure: $command" >&2
  exit 1
fi

session=""
directory=""
window=""
target=""

case "$command" in
  has-session)
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -t)
          session="${2#=}"
          shift 2
          ;;
        *) shift ;;
      esac
    done
    [ -d "$sessions_dir/$session" ]
    ;;
  new-session)
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -s)
          session="${2#=}"
          shift 2
          ;;
        -c)
          directory="$2"
          shift 2
          ;;
        -n)
          window="$2"
          shift 2
          ;;
        *) shift ;;
      esac
    done
    [ -n "$session" ] && [ -n "$directory" ] && [ -n "$window" ] || exit 1
    [ ! -e "$sessions_dir/$session" ] || exit 1
    mkdir -p "$sessions_dir/$session"
    printf '%s\n' "$directory" > "$sessions_dir/$session/root"
    printf '%s\t%s\n' "$window" "$directory" > "$sessions_dir/$session/windows"
    printf '%s\n' "$window" > "$sessions_dir/$session/selected"
    : > "$sessions_dir/$session/commands"
    ;;
  new-window)
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -t)
          session="${2#=}"
          shift 2
          ;;
        -c)
          directory="$2"
          shift 2
          ;;
        -n)
          window="$2"
          shift 2
          ;;
        *) shift ;;
      esac
    done
    [ -d "$sessions_dir/$session" ] || exit 1
    printf '%s\t%s\n' "$window" "$directory" >> "$sessions_dir/$session/windows"
    ;;
  send-keys)
    if [ "${1:-}" = -t ]; then
      target="$2"
      shift 2
    fi
    session="${target%%:*}"
    session="${session#=}"
    [ -d "$sessions_dir/$session" ] || exit 1
    printf '%s\t%s\n' "$target" "${1:-}" >> "$sessions_dir/$session/commands"
    ;;
  select-window)
    if [ "${1:-}" = -t ]; then
      target="$2"
    fi
    session="${target%%:*}"
    session="${session#=}"
    window="${target#*:}"
    [ -d "$sessions_dir/$session" ] || exit 1
    printf '%s\n' "$window" > "$sessions_dir/$session/selected"
    ;;
  kill-session)
    if [ "${1:-}" = -t ]; then
      session="${2#=}"
    fi
    [ -d "$sessions_dir/$session" ] || exit 1
    rm -rf -- "$sessions_dir/$session"
    ;;
  set-option | show-options)
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -t) session="${2#=}"; session="${session%:}"; shift 2 ;;
        -qv) shift ;;
        @archon-managed) shift; break ;;
        *) exit 99 ;;
      esac
    done
    [ -d "$sessions_dir/$session" ] || exit 1
    if [ "$command" = set-option ]; then
      printf '%s' "$1" > "$sessions_dir/$session/managed"
    elif [ -f "$sessions_dir/$session/managed" ]; then
      cat "$sessions_dir/$session/managed"
    fi
    ;;
  list-sessions)
    shopt -s nullglob
    session_paths=("$sessions_dir"/*)
    if [ "${#session_paths[@]}" -eq 0 ]; then
      echo "no server running on fake socket" >&2
      exit 1
    fi
    for session_path in "${session_paths[@]}"; do
      if [[ "${2:-}" == *'@archon-managed'* ]]; then
        marker=""
        [[ ! -f "$session_path/managed" ]] || marker="$(cat "$session_path/managed")"
        printf '%s\t%s\n' "${session_path##*/}" "$marker"
      else
        basename "$session_path"
      fi
    done
    ;;
  attach-session | switch-client)
    if [[ "${1:-}" != -t || -z "${2:-}" ]]; then
      echo 'fake attachment requires an explicit target' >&2
      exit 1
    fi
    target="$2"
    session="${target#=}"
    [[ -d "$sessions_dir/$session" ]] || exit 1
    printf '%s\n' "$target" >> "$state_dir/attachments"
    ;;
  *)
    echo "unsupported fake tmux command: $command" >&2
    exit 1
    ;;
esac
